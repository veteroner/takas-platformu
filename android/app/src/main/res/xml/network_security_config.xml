<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Production HTTPS domains -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">takasyap.netlify.app</domain>
        <domain includeSubdomains="true">netlify.app</domain>
    </domain-config>
    
    <!-- Debug için localhost (sadece debug build'de aktif) -->
    <debug-overrides>
        <domain-config cleartextTrafficPermitted="true">
            <domain includeSubdomains="true">localhost</domain>
            <domain includeSubdomains="true">10.0.2.2</domain>
            <domain includeSubdomains="true">192.168.1.104</domain>
        </domain-config>
    </debug-overrides>
</network-security-config>
