default_platform(:ios)

platform :ios do
  desc 'Build iOS app for TestFlight'
  lane :build_testflight do
    increment_build_number(xcodeproj: 'App/App.xcodeproj')
    build_app(
      scheme: 'App',
      export_method: 'app-store',
      include_bitcode: false,
      output_directory: 'build',
      silent: true
    )
    upload_to_testflight(skip_waiting_for_build_processing: true)
  end

  desc 'Build iOS app for App Store (CI)'
  lane :build_appstore do
    match(type: 'appstore', readonly: true)
    increment_build_number(xcodeproj: 'App/App.xcodeproj')
    
    # Update code signing settings
    update_code_signing_settings(
      use_automatic_signing: false,
      path: 'App/App.xcodeproj',
      team_id: '29D6U2Z923',
      profile_name: 'match AppStore com.teknova.takasapp',
      code_sign_identity: 'Apple Distribution'
    )
    
    build_app(
      scheme: 'App',
      workspace: 'App/App.xcworkspace',
      export_method: 'app-store',
      include_bitcode: false,
      output_directory: 'build',
      output_name: 'TakasApp.ipa',
      silent: false,
      clean: true,
      xcargs: '-allowProvisioningUpdates'
    )
  end

  desc 'Bump version (semantic)'
  lane :bump_version do |options|
    version = options[:version]
    raise 'Version required (e.g. 1.1.0)' unless version
    increment_version_number(version_number: version)
  end
end
