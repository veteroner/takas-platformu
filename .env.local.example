# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Sentry (error monitoring)
# Client-side DSN is optional; prefer server-only DSN if possible
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# App Version (native derlemelerde zorunlu güncelleme için kullanılır)
NEXT_PUBLIC_APP_VERSION=1.0.0

# Google Analytics (isteğe bağlı, consent ile yüklenir)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# OneSignal Push Notifications
NEXT_PUBLIC_ONESIGNAL_APP_ID=f26d64d9-c8c9-48ee-a472-f12cc5c8b629

# AdMob Configuration
CAPACITOR_ADMOB_APP_ID=

# Feature flags (comma separated true/false keys e.g. swipe_ads,premium_badges)
NEXT_PUBLIC_FEATURE_FLAGS=

# Rate limit (requests per window)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
